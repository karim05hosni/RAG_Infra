# Vector Database (Qdrant)
QDRANT_URL='http://localhost:6333'

# Relational Database (PostgreSQL) - matches docker-compose defaults
POSTGRES_URL='postgresql://postgres:postgres@localhost:5432/rag_db'

# Ollama local embeddings/LLM
Ollama_url='http://localhost:11434'
embedding_model='bge-m3'

# LLM Providers & API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
ALTERNATIVE_LLM=gpt-6-luna

# Application Settings
CORS='http://localhost:5173,http://localhost:3000'

# Local HuggingFace Models & Tokenizers
en_to_fr_translation_model='Helsinki-NLP/opus-mt-en-fr'
en_to_fr_tokenizer='Helsinki-NLP/opus-mt-en-fr'
fr_to_en_translation_model='Helsinki-NLP/opus-mt-fr-en'
fr_to_en_tokenizer='Helsinki-NLP/opus-mt-fr-en'
classifier_model='GLiNER2.5-Decide'
